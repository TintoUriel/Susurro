<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación final: ejecutable autocontenido para Windows x64 (no requiere instalar .NET).
  dotnet publish src/Susurro.App -c Release -p:PublishProfile=win-x64
  Salida: artifacts/publish/win-x64/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Las DLL nativas de WPF quedan junto al .exe: no se extrae nada a %TEMP% en cada arranque. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin compresión: comprimir obliga a descomprimir en memoria al iniciar (más RAM). El instalador ya comprime. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- WPF no es compatible con trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
