<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación final: ejecutable autocontenido para Windows x64 (no requiere instalar .NET).
  dotnet publish src/Susurro.App -c Release -p:PublishProfile=win-x64
  Salida: artifacts/publish/win-x64/
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Un único Susurro.exe: las DLL nativas de WPF van dentro y se extraen una sola vez a %TEMP%\.net. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Sin compresión: comprimido pesa ~64 MB en vez de ~140 MB, pero duplica la memoria privada
         en reposo (110 MB vs 53 MB medidos) porque descomprime los ensamblados en memoria. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- WPF no es compatible con trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
