<Window x:Class="Susurro.App.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susurro — Control remoto"
        Style="{StaticResource SusurroWindow}"
        Icon="/Assets/Susurro.ico"
        Width="1024" Height="640"
        MinWidth="400" MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Barra de título -->
        <Grid DockPanel.Dock="Top" Height="32">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" Text="Control remoto" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="FpsText" Text="" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="ControlToggle" Style="{StaticResource ChipToggle}" Content="Controlar"
                              ToolTip="Activar mouse y teclado remoto" Margin="0,0,8,0" VerticalAlignment="Center"
                              Checked="ControlToggle_Changed" Unchecked="ControlToggle_Changed" />
                <Button x:Name="FitButton" Style="{StaticResource ChromeButton}" Content="&#xE9A6;" ToolTip="Ajustar a ventana" Click="Fit_Click" Height="32" Width="40" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Min_Click" Height="32" Width="40" />
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" ToolTip="Maximizar" Click="Max_Click" Height="32" Width="40" />
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Desconectar (Esc)" Height="32" Width="44" />
            </StackPanel>
        </Grid>

        <!-- Barra de estado -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Conectando…" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="ResText" Text="" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Pantalla remota -->
        <Border Background="#FF0A0A0A" ClipToBounds="True">
            <Image x:Name="ScreenImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"
                   MouseMove="Screen_MouseMove" MouseDown="Screen_MouseDown" MouseUp="Screen_MouseUp" MouseWheel="Screen_MouseWheel" />
        </Border>
    </DockPanel>
</Window>
