<Window x:Class="Susurro.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susurro"
        Style="{StaticResource SusurroWindow}"
        Icon="/Assets/Susurro.ico"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de título -->
        <Grid Height="34">
            <TextBlock Text="SUSURRO" Style="{StaticResource AppTitle}" Margin="16,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="&#xE713;" FontSize="12" ToolTip="Configuración" Click="Settings_Click" />
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Minimize_Click" />
                <Button x:Name="CloseButton" Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" ToolTip="Cerrar (Susurro sigue en la bandeja)" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Composición -->
        <StackPanel Grid.Row="1" Margin="16,2,16,14">
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                <TextBlock Text="Para" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="SetupButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontSize="12"
                        Visibility="Collapsed" VerticalAlignment="Center" Click="SetupButton_Click" />
                <Grid>
                    <ComboBox x:Name="RecipientCombo" Height="28" Visibility="Collapsed" MaxDropDownHeight="320"
                              SelectionChanged="RecipientCombo_SelectionChanged" DropDownClosed="RecipientCombo_DropDownClosed"
                              ToolTip="A quién enviarle el mensaje (Ctrl+↑ / Ctrl+↓ para cambiar mientras escribís)"
                              AutomationProperties.Name="Destinatario">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Dot}" Foreground="{Binding DotBrush}" Width="14" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="PeerLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </Grid>
            </DockPanel>

            <TextBox x:Name="Input" Tag="Escribir mensaje…" MaxLength="300" TextWrapping="Wrap" AcceptsReturn="False"
                     MinHeight="40" MaxHeight="104" Padding="9,8" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"
                     AutomationProperties.Name="Mensaje" />

            <Grid Margin="0,10,0,0">
                <ToggleButton x:Name="UrgentToggle" Style="{StaticResource ChipToggle}" Content="Importante" HorizontalAlignment="Left"
                              ToolTip="Mensaje importante: queda en pantalla hasta que la otra persona le haga clic (Ctrl+I)" FontSize="12" />
                <TextBlock x:Name="Counter" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource FaintBrush}" Visibility="Collapsed" />
                <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="96" Click="Send_Click"
                        ToolTip="Enviar (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Enviar" />
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Estado -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8,16,9">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusDot" Text="○" FontSize="12" Width="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Iniciando…" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="Feedback" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                </Grid>
                <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" FontSize="11" Margin="14,3,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
