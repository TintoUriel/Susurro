<Window x:Class="Susurro.App.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susurro — Vincular PCs"
        Style="{StaticResource SusurroWindow}"
        Icon="/Assets/Susurro.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="40">
            <TextBlock x:Name="Heading" Text="Vincular PCs" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="40" Width="44"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <TextBlock x:Name="FooterHint" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,110,0" />
                <Button x:Name="DoneButton" Content="Omitir por ahora" HorizontalAlignment="Right" MinWidth="96" Click="Close_Click" />
            </Grid>
        </Border>

        <StackPanel>
            <!-- Esta PC -->
            <StackPanel Margin="18,4,18,4">
                <TextBlock Text="ESTA PC" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Grid.Column="1" MaxLength="32" Tag="Por ejemplo: Tinto" LostFocus="NameBox_LostFocus" />
                </Grid>
                <TextBlock x:Name="LocalInfo" Style="{StaticResource Caption}" Margin="80,6,0,0" />
            </StackPanel>

            <TabControl x:Name="Modes" Margin="0,12,0,0" SelectionChanged="Modes_SelectionChanged">
                <!-- ================================ Mostrar código -->
                <TabItem Header="Mostrar código">
                    <StackPanel Margin="18,14,18,18">
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Generá un código aquí y escribilo en la otra PC, en «Ingresar código». Es válido por 5 minutos y sirve una sola vez." />
                        <Button x:Name="GenerateButton" Content="Generar código" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,14,0,0" Click="Generate_Click" />
                        <Border x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="16,14" CornerRadius="6"
                                Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="CodeText" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="CodeExpiry" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="HostStatus" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </TabItem>

                <!-- ================================ Ingresar código -->
                <TabItem Header="Ingresar código">
                    <StackPanel Margin="18,14,18,18">
                        <DockPanel>
                            <Button x:Name="SearchButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Buscar de nuevo" FontSize="12" Click="Search_Click" />
                            <TextBlock Text="PCs con Susurro en la red" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </DockPanel>
                        <ListBox x:Name="FoundList" Height="104" Margin="0,6,0,0" SelectionChanged="FoundList_SelectionChanged" />
                        <TextBlock x:Name="SearchStatus" Style="{StaticResource Caption}" Margin="0,4,0,0" FontSize="11" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="8" /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="AddressBox" Grid.Column="1" Tag="IP, IP:puerto o nombre del equipo" />
                            <TextBlock Grid.Row="2" Text="Código" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CodeBox" Grid.Row="2" Grid.Column="1" Tag="XXXX-XXXX" CharacterCasing="Upper" MaxLength="11"
                                     FontFamily="{StaticResource MonoFont}" FontSize="15" KeyDown="CodeBox_KeyDown" />
                        </Grid>
                        <Button x:Name="JoinButton" Content="Vincular" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="80,12,0,0" MinWidth="100" Click="Join_Click" />
                        <TextBlock x:Name="JoinStatus" Style="{StaticResource Caption}" Margin="80,10,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </DockPanel>
</Window>
