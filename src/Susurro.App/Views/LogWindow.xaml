<Window x:Class="Susurro.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susurro — Registro"
        Style="{StaticResource SusurroWindow}"
        Icon="/Assets/Susurro.ico"
        Width="720" Height="460" MinWidth="420" MinHeight="260"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="40">
            <TextBlock Text="Registro" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="40" Width="44"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,330,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Actualizar" Click="Refresh_Click" />
                    <Button Content="Copiar" Click="Copy_Click" Margin="8,0,0,0" />
                    <Button Content="Abrir carpeta" Click="Folder_Click" Margin="8,0,0,0" />
                    <Button Content="Cerrar" Click="Close_Click" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBox x:Name="LogText" IsReadOnly="True" Margin="18,4,18,14" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top" AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,6" />
                    </Border>
                </ControlTemplate>
            </TextBox.Template>
        </TextBox>
    </DockPanel>
</Window>
