<Window x:Class="Susurro.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Susurro — Bienvenida"
        Style="{StaticResource SusurroWindow}"
        Icon="/Assets/Susurro.ico"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="40">
            <TextBlock Text="Bienvenido a Susurro" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
            <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Height="40" Width="44"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="Cerrar" />
        </Grid>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <TextBlock x:Name="Hint" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,110,0" />
                <Button x:Name="StartButton" Content="Empezar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="96"
                        IsDefault="True" IsEnabled="False" Click="Start_Click" />
            </Grid>
        </Border>

        <StackPanel Margin="18,6,18,20">
            <TextBlock Text="¿Cómo te llamás?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBox x:Name="NameBox" MaxLength="32" Tag="Tu nombre, por ejemplo: Uriel" FontSize="14" Padding="9,7"
                     TextChanged="NameBox_TextChanged" AutomationProperties.Name="Tu nombre" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="Así te van a ver tus compañeros cuando les escribas." />

            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sin códigos ni vinculación" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Todas las personas que tengan Susurro abierto en esta red aparecen solas en la lista. Al escribir elegís a quién mandarle el mensaje, o a todos los conectados." />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
